#!/usr/bin/env bash
set -euo pipefail

# Installs the release-fast binary as a standalone shortcut, separate from
# any Stable Zed install (~/.local/zed.app + dev.zed.Zed.desktop). Never
# touches those paths.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="$repo_root/target/release-fast/zed"
icon="$repo_root/crates/zed/resources/app-icon-dev.png"

if [[ ! -x "$binary" ]]; then
  echo "error: $binary not found. Run 'mise run build:fast' (or run:fast) first." >&2
  exit 1
fi

bin_dir="$HOME/.local/bin"
apps_dir="$HOME/.local/share/applications"
link="$bin_dir/zed-fast"
# Filename must match the app_id the dev-channel binary reports to Wayland
# (ReleaseChannel::Dev::app_id() == "dev.zed.Zed-Dev", see
# crates/release_channel/src/lib.rs). GNOME Shell matches a running window
# to a launcher by this id, not by the file's old arbitrary name — a
# mismatch is why it fell back to the generic "gear" icon and pinning
# produced a broken launcher.
desktop_file="$apps_dir/dev.zed.Zed-Dev.desktop"
old_desktop_file="$apps_dir/dev.zed.Zed-Fast.desktop"

mkdir -p "$bin_dir" "$apps_dir"
ln -sf "$binary" "$link"
rm -f "$old_desktop_file"

cat > "$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Zed (Fast/DB dev)
GenericName=Text Editor
Comment=Locally built release-fast Zed with the db_client feature branch
TryExec=$link
StartupNotify=true
StartupWMClass=dev.zed.Zed-Dev
Exec=$link %U
Icon=$icon
Categories=Utility;TextEditor;Development;IDE;
Keywords=zed;fast;dev;
EOF

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$apps_dir" >/dev/null 2>&1 || true
fi

echo "Installed:"
echo "  binary symlink : $link -> $binary"
echo "  app launcher   : $desktop_file"
echo "Look for \"Zed (Fast/DB dev)\" in your app grid (distinct grey icon)."
