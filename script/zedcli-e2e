#!/usr/bin/env bash
set -euo pipefail

ZED=${1:-$HOME/.local/lib/zed-fast/zed}
ZEDCLI=${2:-$HOME/.local/lib/zed-fast/zedcli}
DISPLAY_NUMBER=${ZEDCLI_E2E_DISPLAY:-97}
MYSQL_PORT=${ZEDCLI_E2E_MYSQL_PORT:-33961}
HTTP_PORT=${ZEDCLI_E2E_HTTP_PORT:-33962}
POSTGRES_PORT=${ZEDCLI_E2E_POSTGRES_PORT:-33963}
REDIS_PORT=${ZEDCLI_E2E_REDIS_PORT:-33964}
MONGO_PORT=${ZEDCLI_E2E_MONGO_PORT:-33965}
POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine
MONGO_IMAGE=mirror.gcr.io/library/mongo:7
MYSQL_IMAGE=${ZEDCLI_E2E_MYSQL_IMAGE:-docker.io/library/mysql:8.4}

for tool in podman Xvfb xdotool; do
    command -v "$tool" >/dev/null || { echo "zedcli-e2e: $tool is required" >&2; exit 2; }
done
[ -x "$ZED" ] || { echo "zedcli-e2e: no editor at $ZED" >&2; exit 2; }
[ -x "$ZEDCLI" ] || { echo "zedcli-e2e: no zedcli at $ZEDCLI" >&2; exit 2; }
for port in "$MYSQL_PORT" "$HTTP_PORT" "$POSTGRES_PORT" "$REDIS_PORT" "$MONGO_PORT"; do
    if ss -ltn | grep -q ":$port "; then
        echo "zedcli-e2e: port $port is taken; set ZEDCLI_E2E_MYSQL_PORT or ZEDCLI_E2E_HTTP_PORT" >&2
        exit 2
    fi
done
if [ -e "/tmp/.X11-unix/X$DISPLAY_NUMBER" ]; then
    echo "zedcli-e2e: display :$DISPLAY_NUMBER is taken; set ZEDCLI_E2E_DISPLAY" >&2
    exit 2
fi

ROOT=$(mktemp -d /tmp/zedcli-e2e.XXXXXX)
CONTAINER="zedcli-e2e-mysql-$$"
POSTGRES="zedcli-e2e-postgres-$$"
REDIS="zedcli-e2e-redis-$$"
MONGO="zedcli-e2e-mongo-$$"
# Images this run pulls are removed again at the end; ones already here stay.
PULLED_IMAGES=()
for image in "$POSTGRES_IMAGE" "$REDIS_IMAGE" "$MONGO_IMAGE"; do
    podman image exists "$image" || PULLED_IMAGES+=("$image")
done
XVFB_PID=""
ZED_PID=""
HTTP_PID=""

cleanup() {
    [ -n "$ZED_PID" ] && kill "$ZED_PID" 2>/dev/null || true
    [ -n "$XVFB_PID" ] && kill "$XVFB_PID" 2>/dev/null || true
    [ -n "$HTTP_PID" ] && kill "$HTTP_PID" 2>/dev/null || true
    podman rm -f "$CONTAINER" "$POSTGRES" "$REDIS" "$MONGO" >/dev/null 2>&1 || true
    for image in "${PULLED_IMAGES[@]}"; do
        podman rmi "$image" >/dev/null 2>&1 || true
    done
    # A run the editor started may have outlived it; they carry the scratch root.
    pgrep -f "$ROOT" | xargs -r kill -9 2>/dev/null || true
    rm -rf "$ROOT"
}
trap cleanup EXIT

PASSED=0
FAILED=0
pass() { PASSED=$((PASSED + 1)); echo "  ok    $1"; }
fail() {
    FAILED=$((FAILED + 1))
    echo "  FAIL  $1"
    if [ -n "${2:-}" ]; then echo "$2" | sed 's/^/        /'; fi
}

zc() { "$ZEDCLI" --user-data-dir "$ROOT/data" --timeout 30 "$@"; }

# Runs zedcli and checks its exit status: expect <status> <name> -- <args...>
expect_status() {
    local want=$1 name=$2
    shift 3
    local out status
    out=$(zc "$@" 2>&1) && status=0 || status=$?
    if [ "$status" = "$want" ]; then pass "$name"; else fail "$name (exit $status, wanted $want)" "$out"; fi
}

echo "== MySQL on 127.0.0.1:$MYSQL_PORT"
podman run -d --rm --name "$CONTAINER" -e MYSQL_ROOT_PASSWORD=e2e-root -e MYSQL_DATABASE=shop \
    -p "127.0.0.1:$MYSQL_PORT:3306" "$MYSQL_IMAGE" --log-bin-trust-function-creators=1 >/dev/null
echo "== PostgreSQL, Redis and MongoDB"
podman run -d --rm --name "$POSTGRES" -e POSTGRES_PASSWORD=e2e-root -e POSTGRES_DB=shop \
    -p "127.0.0.1:$POSTGRES_PORT:5432" "$POSTGRES_IMAGE" >/dev/null
podman run -d --rm --name "$REDIS" -p "127.0.0.1:$REDIS_PORT:6379" "$REDIS_IMAGE" >/dev/null
podman run -d --rm --name "$MONGO" -p "127.0.0.1:$MONGO_PORT:27017" "$MONGO_IMAGE" >/dev/null
# The image first runs a server of its own to initialise the data directory and
# then restarts; only the line naming port 3306 is the one that stays up.
for _ in $(seq 1 120); do
    podman logs "$CONTAINER" 2>&1 | grep -q 'port: 3306  MySQL Community' && break
    sleep 1
done
SEEDED=""
for _ in $(seq 1 20); do
    if podman exec "$CONTAINER" mysql -uroot -pe2e-root shop -e "
        CREATE TABLE IF NOT EXISTS users (id INT PRIMARY KEY, name VARCHAR(40) NULL);
        REPLACE INTO users VALUES (1, 'Ada'), (2, 'Grace, \"the admiral\"'), (3, NULL);
        CREATE TABLE IF NOT EXISTS log (id INT);" 2>/dev/null; then
        SEEDED=1
        break
    fi
    sleep 1
done
[ -n "$SEEDED" ] || { echo "zedcli-e2e: MySQL never took the seed data"; podman logs "$CONTAINER" 2>&1 | tail -5; exit 1; }
# The body holds statements of its own, so it goes in with a delimiter the
# client does not split on.
printf '%s\n' 'DROP FUNCTION IF EXISTS bump;' 'DELIMITER //' \
    'CREATE FUNCTION bump() RETURNS INT NOT DETERMINISTIC MODIFIES SQL DATA BEGIN INSERT INTO log VALUES (1); RETURN 1; END//' \
    'DELIMITER ;' | podman exec -i "$CONTAINER" mysql -uroot -pe2e-root shop 2>/dev/null \
    || { echo "zedcli-e2e: MySQL did not take the function"; exit 1; }

# A function that writes, called from what reads as a plain SELECT: the one
# thing no reading of the text can catch, so the database itself has to.
pg() { podman exec "$POSTGRES" psql -U postgres -d shop -tA -c "$1"; }
for _ in $(seq 1 60); do
    pg "SELECT 1" >/dev/null 2>&1 && break
    sleep 1
done
pg "CREATE TABLE users (id INT PRIMARY KEY, name TEXT);
    INSERT INTO users VALUES (1, 'Ada'), (2, 'Grace');
    CREATE TABLE log (id INT);
    CREATE FUNCTION bump() RETURNS INT VOLATILE LANGUAGE sql AS 'INSERT INTO log VALUES (1) RETURNING 1';" >/dev/null
for _ in $(seq 1 30); do
    podman exec "$REDIS" redis-cli ping 2>/dev/null | grep -q PONG && break
    sleep 1
done
podman exec "$REDIS" redis-cli SET greeting hello >/dev/null
mongo() { podman exec "$MONGO" mongosh --quiet shop --eval "$1"; }
for _ in $(seq 1 60); do
    mongo "db.runCommand({ ping: 1 }).ok" 2>/dev/null | grep -q 1 && break
    sleep 1
done
mongo 'db.users.insertMany([{ _id: 1, name: "Ada" }, { _id: 2, name: "Grace" }])' >/dev/null

echo "== Editor on :$DISPLAY_NUMBER"
# An editor started with --user-data-dir keeps its configuration inside it.
# MySQL 8 lets caching_sha2_password in only over TLS, hence ssl_mode Require.
mkdir -p "$ROOT/home" "$ROOT/data/config" "$ROOT/project/.zed"
cat >"$ROOT/data/config/db_connections.json" <<JSON
{
  "folders": [],
  "connections": [
    {
      "id": "6b1d0f0e-4c47-4d6a-9d7c-0e2e2e5e0001",
      "label": "e2e-mysql",
      "driver": "MySQL",
      "host": "127.0.0.1",
      "port": $MYSQL_PORT,
      "username": "root",
      "password": "e2e-root",
      "database": "shop",
      "ssl_mode": "Require"
    },
    {
      "id": "6b1d0f0e-4c47-4d6a-9d7c-0e2e2e5e0002",
      "label": "e2e-mysql-read-only",
      "driver": "MySQL",
      "host": "127.0.0.1",
      "port": $MYSQL_PORT,
      "username": "root",
      "password": "e2e-root",
      "database": "shop",
      "ssl_mode": "Require",
      "read_only": true
    },
    {
      "id": "6b1d0f0e-4c47-4d6a-9d7c-0e2e2e5e0003",
      "label": "e2e-postgres",
      "driver": "PostgreSQL",
      "host": "127.0.0.1",
      "port": $POSTGRES_PORT,
      "username": "postgres",
      "password": "e2e-root",
      "database": "shop"
    },
    {
      "id": "6b1d0f0e-4c47-4d6a-9d7c-0e2e2e5e0004",
      "label": "e2e-redis",
      "driver": "Redis",
      "host": "127.0.0.1",
      "port": $REDIS_PORT,
      "username": "",
      "password": ""
    },
    {
      "id": "6b1d0f0e-4c47-4d6a-9d7c-0e2e2e5e0005",
      "label": "e2e-mongo",
      "driver": "MongoDB",
      "host": "127.0.0.1",
      "port": $MONGO_PORT,
      "username": "",
      "password": "",
      "database": "shop"
    }
  ]
}
JSON
# The run leaves a program in a session of its own behind, the way a server
# started by a script does; Stop has to end it as well.
cat >"$ROOT/project/.zed/tasks.json" <<JSON
[
  { "label": "sleeper", "command": "sh", "args": ["-c", "setsid sleep 300 & sleep 300"] },
  { "label": "unit tests", "command": "true" }
]
JSON
echo 'fn main() {}' >"$ROOT/project/main.rs"

# The API client's saved requests, one with a test script, and a server that
# echoes the path it was asked for.
cat >"$ROOT/data/config/api_collections.json" <<JSON
{
  "collections": [{ "id": "a0000000-0000-4000-8000-000000000001", "name": "Shop", "variables": [] }],
  "folders": [{ "id": "a0000000-0000-4000-8000-000000000002", "collection_id": "a0000000-0000-4000-8000-000000000001", "name": "Orders" }],
  "requests": [
    {
      "id": "a0000000-0000-4000-8000-000000000003",
      "collection_id": "a0000000-0000-4000-8000-000000000001",
      "folder_id": "a0000000-0000-4000-8000-000000000002",
      "name": "Get order",
      "method": "Get",
      "url": "{{host}}/orders/{{id}}",
      "test_script": "pm.test(\"is found\", () => { pm.expect(pm.response.code).to.equal(200); });"
    },
    {
      "id": "a0000000-0000-4000-8000-000000000004",
      "collection_id": "a0000000-0000-4000-8000-000000000001",
      "name": "Broken",
      "method": "Get",
      "url": "{{host}}/boom"
    },
    {
      "id": "a0000000-0000-4000-8000-000000000005",
      "collection_id": "a0000000-0000-4000-8000-000000000001",
      "name": "Cancel order",
      "method": "Delete",
      "url": "{{host}}/orders/1"
    }
  ],
  "tree_order": "name"
}
JSON
cat >"$ROOT/data/config/api_environments.json" <<JSON
{
  "environments": [
    { "id": "b0000000-0000-4000-8000-000000000001", "name": "local",
      "variables": [
        { "key": "host", "initial_value": "http://127.0.0.1:$HTTP_PORT", "current_value": "http://127.0.0.1:$HTTP_PORT", "secret": false, "enabled": true },
        { "key": "token", "initial_value": "e2e-secret-token", "current_value": "e2e-secret-token", "secret": true, "enabled": true }
      ] }
  ],
  "global": { "id": "00000000-0000-0000-0000-000000000000", "name": "Globals", "variables": [] }
}
JSON
/usr/bin/python3 - "$HTTP_PORT" >/dev/null 2>&1 <<'SERVER' &
import http.server, json, sys
class Echo(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        code = 500 if self.path == "/boom" else 200
        body = json.dumps({"path": self.path}).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, *args):
        pass
http.server.HTTPServer(("127.0.0.1", int(sys.argv[1])), Echo).serve_forever()
SERVER
HTTP_PID=$!

Xvfb ":$DISPLAY_NUMBER" -screen 0 1600x1000x24 -nolisten tcp >/dev/null 2>&1 &
XVFB_PID=$!
sleep 1
env -u WAYLAND_DISPLAY -u XDG_SESSION_TYPE DISPLAY=":$DISPLAY_NUMBER" GDK_BACKEND=x11 \
    HOME="$ROOT/home" XDG_CONFIG_HOME="$ROOT/home/.config" XDG_DATA_HOME="$ROOT/home/.local/share" \
    "$ZED" --user-data-dir "$ROOT/data" "$ROOT/project" >"$ROOT/zed.log" 2>&1 &
ZED_PID=$!

SOCKET=""
for _ in $(seq 1 60); do
    SOCKET=$(ls "$ROOT/data"/zed-*.sock 2>/dev/null | head -1 || true)
    [ -n "$SOCKET" ] && break
    sleep 1
done
[ -n "$SOCKET" ] || { echo "zedcli-e2e: the editor never listened"; tail -20 "$ROOT/zed.log"; exit 1; }
# A scratch HOME opens the project in Restricted Mode, whose dialog holds back
# the project's tasks until it is trusted.
for _ in $(seq 1 30); do
    zc windows --json 2>/dev/null | grep -q "$ROOT/project" && break
    sleep 1
done
DISPLAY=":$DISPLAY_NUMBER" xdotool mousemove 800 500
sleep 1
DISPLAY=":$DISPLAY_NUMBER" xdotool key --clearmodifiers Return
sleep 2

echo "== the socket"
[ "$(stat -c %a "$SOCKET")" = 600 ] && pass "only its own user can reach the socket" \
    || fail "only its own user can reach the socket" "$(stat -c '%a %U' "$SOCKET")"

echo "== windows"
out=$(zc windows --json) || true
echo "$out" | grep -q "\"$ROOT/project\"" && pass "the project's window is listed" || fail "the project's window is listed" "$out"
WINDOW=$(echo "$out" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["id"])' 2>/dev/null) || {
    echo "zedcli-e2e: no window to test against"; tail -20 "$ROOT/zed.log"; exit 1; }
zc windows | head -1 | grep -q '^WINDOW' && pass "the table has a header" || fail "the table has a header"
expect_status 4 "an unknown window is not found" -- ps --window 999999999

echo "== configs"
out=$(cd "$ROOT/project" && zc configs) || true
echo "$out" | grep -q sleeper && pass "configurations are found from the project directory" \
    || fail "configurations are found from the project directory" "$out"

echo "== runs are only looked at"
out=$(zc ps --window "$WINDOW") || true
echo "$out" | grep -q "No task runs" && pass "ps lists the runs, here none" || fail "ps lists the runs, here none" "$out"
for command in run stop restart; do
    expect_status 2 "there is no $command command" -- "$command" sleeper --window "$WINDOW"
done

echo "== db"
out=$(zc db connections) || true
echo "$out" | grep -q e2e-mysql && pass "the saved connection is listed" || fail "the saved connection is listed" "$out"
echo "$out" | grep -q e2e-root && fail "the password is never printed" "$out" || pass "the password is never printed"
out=$(zc db query -c e2e-mysql --csv "SELECT id, name FROM users ORDER BY id") || true
want=$'id,name\n1,Ada\n2,"Grace, ""the admiral"""\n3,'
[ "$out" = "$want" ] && pass "a query prints as CSV, quoting and NULL included" || fail "a query prints as CSV, quoting and NULL included" "$out"
out=$(echo "SELECT COUNT(*) AS n FROM users" | zc db query -c e2e-mysql --json) || true
echo "$out" | grep -q '"n": "3"' && pass "SQL is read from stdin and printed as JSON" || fail "SQL is read from stdin and printed as JSON" "$out"
expect_status 1 "an SQL error is a failed request" -- db query -c e2e-mysql "SELECT nope FROM users"

echo "== only reads get through"
mysql_count() { podman exec "$CONTAINER" mysql -uroot -pe2e-root shop -N -e "$1" 2>/dev/null; }
for write in \
    "UPDATE users SET name = 'x' WHERE id = 1" \
    "DELETE FROM users" \
    "DROP TABLE users" \
    "INSERT INTO users VALUES (9, 'x')" \
    "SELECT 1; DELETE FROM users" \
    "SELECT 1 /*! ; DELETE FROM users */" \
    "SELECT * FROM users FOR UPDATE" \
    "SELECT * FROM users INTO OUTFILE '/tmp/x'"; do
    expect_status 5 "MySQL refuses: $write" -- db query -c e2e-mysql "$write"
done
# The database's own refusal, not any error: a missing function would fail too.
hidden=$(zc db query -c e2e-mysql "SELECT bump()" 2>&1) && status=0 || status=$?
[ "$status" = 1 ] && echo "$hidden" | grep -qi "read.only" && pass "MySQL itself refuses a write hidden in a function" \
    || fail "MySQL itself refuses a write hidden in a function" "exit $status: $hidden"
[ "$(mysql_count 'SELECT COUNT(*) FROM log')" = 0 ] && pass "the function wrote nothing" \
    || fail "the function wrote nothing" "log holds $(mysql_count 'SELECT COUNT(*) FROM log') rows"
[ "$(mysql_count 'SELECT COUNT(*) FROM users')" = 3 ] && [ "$(mysql_count 'SELECT name FROM users WHERE id = 1')" = Ada ] \
    && pass "MySQL data is untouched" || fail "MySQL data is untouched"

out=$(zc db query -c e2e-postgres --csv "SELECT name FROM users ORDER BY id") || true
[ "$out" = $'name\nAda\nGrace' ] && pass "PostgreSQL reads" || fail "PostgreSQL reads" "$out"
for write in \
    "UPDATE users SET name = 'x'" \
    "WITH d AS (DELETE FROM users RETURNING *) SELECT * FROM d" \
    "SELECT \$\$'\$\$; DELETE FROM users; --'" \
    "SELECT nextval('s')" \
    "COPY users TO '/tmp/x'"; do
    expect_status 5 "PostgreSQL refuses: $write" -- db query -c e2e-postgres "$write"
done
hidden=$(zc db query -c e2e-postgres "SELECT bump()" 2>&1) && status=0 || status=$?
[ "$status" = 1 ] && echo "$hidden" | grep -qi "read.only" && pass "PostgreSQL itself refuses a write hidden in a function" \
    || fail "PostgreSQL itself refuses a write hidden in a function" "exit $status: $hidden"
[ "$(pg 'SELECT COUNT(*) FROM log')" = 0 ] && pass "the function wrote nothing" \
    || fail "the function wrote nothing" "log holds $(pg 'SELECT COUNT(*) FROM log') rows"
[ "$(pg 'SELECT COUNT(*) FROM users')" = 2 ] && pass "PostgreSQL data is untouched" || fail "PostgreSQL data is untouched"

out=$(zc db query -c e2e-redis "GET greeting") || true
echo "$out" | grep -q hello && pass "Redis reads" || fail "Redis reads" "$out"
for write in "SET greeting bye" "DEL greeting" "GETDEL greeting" "EVAL \"return redis.call('DEL','greeting')\" 0" "FLUSHALL"; do
    expect_status 5 "Redis refuses: $write" -- db query -c e2e-redis "$write"
done
[ "$(podman exec "$REDIS" redis-cli GET greeting)" = hello ] && pass "Redis data is untouched" || fail "Redis data is untouched"

out=$(zc db query -c e2e-mongo --json 'db.users.find({ name: "Ada" })') || true
echo "$out" | grep -q Ada && pass "MongoDB reads" || fail "MongoDB reads" "$out"
for write in \
    'db.users.deleteMany({})' \
    'db.users.updateOne({ _id: 1 }, { $set: { name: "x" } })' \
    'db.users.insertOne({ _id: 9 })' \
    'db.users.aggregate([{ $match: {} }, { $out: "copy" }])' \
    'db.users.drop()'; do
    expect_status 5 "MongoDB refuses: $write" -- db query -c e2e-mongo "$write"
done
[ "$(mongo 'db.users.countDocuments({})')" = 2 ] && [ "$(mongo 'db.getCollectionNames().includes("copy")')" = false ] \
    && pass "MongoDB data is untouched" || fail "MongoDB data is untouched"
expect_status 4 "an unknown connection is not found" -- db query -c no-such-connection "SELECT 1"
out=$(zc db query -c e2e-mysql --json "WITH RECURSIVE n AS (SELECT 1 AS x UNION ALL SELECT x + 1 FROM n WHERE x < 600) SELECT x FROM n") || true
ROWS=$(echo "$out" | /usr/bin/python3 -c 'import json,sys; print(len(json.load(sys.stdin)["rows"]))' 2>/dev/null || echo "?")
echo "  info  a 600-row query came back with $ROWS rows"
[ "$ROWS" -gt 0 ] 2>/dev/null && pass "a large result comes back" || fail "a large result comes back" "$out"
expect_status 0 "a read-only connection still reads" -- db query -c e2e-mysql-read-only "SELECT COUNT(*) FROM users"
expect_status 5 "a read-only connection refuses a write" -- db query -c e2e-mysql-read-only "UPDATE users SET name = 'x' WHERE id = 1"
out=$(zc db query -c e2e-mysql --csv "SELECT name FROM users WHERE id = 1") || true
[ "$out" = $'name\nAda' ] && pass "the refused write changed nothing" || fail "the refused write changed nothing" "$out"

echo "== api"
out=$(zc api list) || true
echo "$out" | grep -q "Shop/Orders/Get order" && pass "saved requests are listed by path" || fail "saved requests are listed by path" "$out"
out=$(zc api envs) || true
echo "$out" | grep -q "local" && pass "environments are listed" || fail "environments are listed" "$out"
echo "$out" | grep -q "e2e-secret-token" && fail "a variable's value is never printed" "$out" || pass "a variable's value is never printed"
out=$(zc api send "Shop/Orders/Get order" --env local --var id=42 2>/dev/null) || true
[ "$out" = '{"path": "/orders/42"}' ] && pass "a request is sent with the environment and a one-off value" \
    || fail "a request is sent with the environment and a one-off value" "$out"
err=$(zc api send "Get order" --env local --var id=7 2>&1 >/dev/null) || true
echo "$err" | grep -q "pass  is found" && pass "the request's test script runs" || fail "the request's test script runs" "$err"
expect_status 0 "an error status is still an answer" -- api send Broken --env local
expect_status 1 "--fail makes an error status a failure" -- api send Broken --env local --fail
expect_status 4 "an unknown request is not found" -- api send "Nowhere" --env local
expect_status 5 "a request that could change data is refused" -- api send "Cancel order" --env local
zc api send "Get order" --env local --var id=9 -o "$ROOT/body.json" >/dev/null 2>&1 || true
grep -q '/orders/9' "$ROOT/body.json" 2>/dev/null && pass "-o writes the body to a file" || fail "-o writes the body to a file"

echo "== after the editor is gone"
kill "$ZED_PID"
wait "$ZED_PID" 2>/dev/null || true
ZED_PID=""
expect_status 3 "no running editor is said as such" -- windows

echo
if [ "$FAILED" != 0 ]; then
    echo "-- last lines of the editor's log"
    tail -25 "$ROOT/zed.log"
fi
echo "zedcli-e2e: $PASSED passed, $FAILED failed"
[ "$FAILED" = 0 ]
